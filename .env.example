# ---------------------------------------------------------------------------
# Browser-safe configuration (bundled into the client).
# Only the project URL and the anon/publishable key belong here. Both are
# public by design; every table is protected by row-level security.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL used for canonical links, Open Graph tags and the sitemap.
VITE_SITE_URL=https://www.example.com

# ---------------------------------------------------------------------------
# NEVER put the service-role key, database password or any other secret in a
# VITE_ variable. The build fails if a VITE_ variable looks like a secret.
# Server-side secrets are configured as Supabase Edge Function secrets:
#   supabase secrets set ALLOWED_ORIGINS=https://www.example.com
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically by Supabase.
# ---------------------------------------------------------------------------
